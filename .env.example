# 견본 파일입니다. 이 파일을 복사해 .env 를 만들고 = 뒤에 값을 넣으세요 (띄어쓰기·따옴표 없이)
#   cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 값은 코드·로그·커밋에 넣지 마세요.
# Streamlit Cloud 에서는 이 값들을 앱 설정의 Secrets 메뉴에 같은 이름으로 넣고,
# 메일 발송(GitHub Actions)은 저장소 Settings > Secrets 에 같은 이름으로 넣습니다.

# API Ninjas Exercises (https://api-ninjas.com 에서 무료 키 발급)
API_NINJAS_KEY=

# Open-Meteo(날씨·대기질)는 키가 필요 없습니다.

# MyMemory 번역 (선택). 비우면 하루 5,000자, 이메일을 넣으면 하루 50,000자까지 번역합니다.
# 한도는 서버 전체가 함께 씁니다. 사용자 메일이 아닌 운영자용 주소를 넣으세요 (MyMemory에 전달됩니다).
MYMEMORY_EMAIL=

# Google Sheets (users / logs / sends 시트가 들어 있는 스프레드시트)
# 스프레드시트 주소의 /d/ 와 /edit 사이 값
GOOGLE_SHEET_ID=
# 서비스 계정 JSON 파일 내용을 한 줄로 붙여 넣기 (스프레드시트를 이 계정 이메일에 편집자로 공유)
GOOGLE_SERVICE_ACCOUNT_JSON=

# 알림 메일 (Gmail SMTP, 구글 계정 2단계 인증 후 발급한 앱 비밀번호 16자리)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 알림 메일에 넣을 앱 주소 (배포 전에는 http://localhost:8501)
APP_URL=http://localhost:8501
